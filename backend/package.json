{
  "name": "ai-fullstack-lab-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "db:migrate": "tsx src/persistence/migrate.ts",
    "test": "tsx --test src/config.test.ts src/context/*.test.ts src/memory/*.test.ts src/embeddings/*.test.ts src/vector-store/*.test.ts src/retrieval/*.test.ts src/evaluation/*.test.ts",
    "evaluate:memory": "tsx src/evaluation/run-memory-evaluation.ts",
    "start": "node dist/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "openai": "^6.49.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
